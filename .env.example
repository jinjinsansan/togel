NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-r2-bucket
R2_PUBLIC_BASE_URL=https://assets.to-gel.com

# LINE Bot
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
NEXT_PUBLIC_LIFF_ID=your-liff-id

# Security
# 招待リンク(いたずら機能)のHMAC署名鍵。未設定だと招待機能は無効化される（フェイルクローズ）
INVITE_SECRET=generate-a-long-random-string
# データ移行/管理系APIをサーバー間で叩くための内部シークレット（x-internal-secret ヘッダ）
INTERNAL_API_SECRET=generate-a-long-random-string
# One.lat 決済 Webhook の署名シークレット（未設定だと決済Webhookは拒否される）
ONE_LAT_WEBHOOK_SECRET=your-one-lat-webhook-secret
