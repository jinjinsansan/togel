NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-r2-bucket
R2_PUBLIC_BASE_URL=https://assets.to-gel.com

# メール（Resend）。確認メール・再設定メールは Supabase の SMTP 設定にも同じキーを入れる
RESEND_API_KEY=re_xxxxxxxx
# 差出人。Resend で to-gel.com のドメイン認証（DNS は Cloudflare）が済んでいること
RESEND_FROM_EMAIL=Togel <noreply@to-gel.com>

# メルマガ（週1通・全15通）。CRON_SECRET と RESEND_API_KEY の両方が無いと配信は止まる（503）
# CRON_SECRET は自分で生成する（例: openssl rand -hex 32）。外部から提示された値は使わない
CRON_SECRET=
# 1日に送るメルマガの上限（既定80・最大100。Resend 無料枠は1日100通）
NEWSLETTER_DAILY_LIMIT=80
# メール本文のリンクに使うサイトのURL
NEXT_PUBLIC_APP_URL=https://to-gel.com

# Security
# 招待リンク(いたずら機能)のHMAC署名鍵。未設定だと招待機能は無効化される（フェイルクローズ）
INVITE_SECRET=generate-a-long-random-string
# データ移行/管理系APIをサーバー間で叩くための内部シークレット（x-internal-secret ヘッダ）
INTERNAL_API_SECRET=generate-a-long-random-string
# One.lat 決済 Webhook の署名シークレット（未設定だと決済Webhookは拒否される）
ONE_LAT_WEBHOOK_SECRET=your-one-lat-webhook-secret
